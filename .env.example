# 复制成 .env 再填真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交；这份示例文件只放占位符，**不要在这里填真 Key**

# ── DeepSeek ─────────────────────────────────────────
# Key 由讲师现场分发（不在仓库里，也不要贴进群消息/提交进代码）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 换别的模型/网关就改上面三个，代码里统一从环境变量读，不要硬编码

# ── 服务 ─────────────────────────────────────────────
# 参考 UI 截图用的是 5001
PORT=5001

# ── 演示开关 ─────────────────────────────────────────
# 置为 true 让工具调用必定失败，用于演示高可用降级（eval.md §3 要测这个）
FORCE_TOOL_FAILURE=false
